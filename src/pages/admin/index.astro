---
/**
 * Casca do painel de edição (Sveltia CMS).
 *
 * Existe como rota do Astro, e não como HTML solto em `public/admin/`, por um
 * motivo prático: o servidor de desenvolvimento não resolve `/admin` para o
 * `index.html` de uma pasta em `public/` — só `/admin/index.html` abriria,
 * enquanto em produção o `.htaccess` resolve. Como rota, o endereço é o mesmo
 * nos dois ambientes, e o que você testa localmente é o que vai para o ar.
 *
 * A página não usa o BaseLayout de propósito: nada do site — fontes, CSS,
 * tema, AdSense — deve ser carregado aqui. O painel é uma aplicação separada
 * que só por acaso mora no mesmo domínio.
 */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      O painel nunca deve ser indexado. O `noindex` cobre os buscadores que
      respeitam a meta tag; o `Disallow` no robots.txt cobre o rastreamento; e o
      público-alvo real (você) chega aqui pelo endereço direto.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <title>Editor · Contracorrente</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <style>
      /* Tela de carregamento na paleta do site, para o painel não abrir com um
         flash branco antes do bundle de 2,3 MB ser avaliado. */
      :root {
        color-scheme: light dark;
      }

      body {
        margin: 0;
        background: #faf8f4;
        color: #17120e;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background: #0c0a08;
          color: #f0eae2;
        }
      }

      #carregando {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        gap: 0.75rem;
        text-align: center;
        padding: 1.5rem;
      }

      #carregando b {
        font-family: Georgia, serif;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
      }

      #carregando span {
        font-size: 0.875rem;
        opacity: 0.6;
      }

      /* Some assim que o CMS monta a interface por cima. */
      body:has(#nc-root:not(:empty)) #carregando,
      body:has([data-sveltia-cms]) #carregando {
        display: none;
      }
    </style>
  </head>

  <body>
    <div id="carregando">
      <b>Contracorrente</b>
      <span>Carregando o editor…</span>
      <span
        >Se esta tela não sair, rode <code>npm run dev</code> novamente para regenerar o painel.</span
      >
    </div>

    <!--
      Bundle auto-hospedado, copiado de node_modules por `scripts/sync-cms.mjs`.
      Servido do próprio domínio para respeitar a CSP (`script-src 'self'`).
    -->
    {
      /* `is:inline` impede o Astro de tentar empacotar o bundle: ele é um
        arquivo pronto em `public/`, não um módulo do projeto. */
    }
    <script is:inline src="/admin/sveltia-cms.js"></script>
  </body>
</html>
