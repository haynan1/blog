---
interface Props {
  page: number;
  totalPages: number;
  /** Recebe o número e devolve a URL. Página 1 deve mapear para a raiz da rota. */
  buildHref: (page: number) => string;
  label?: string;
}

const { page, totalPages, buildHref, label = 'Paginação' } = Astro.props;

/**
 * Janela de páginas: primeira, última, a atual e as vizinhas — com reticências
 * no meio. Listar 40 páginas seria um muro de links de baixo valor que o
 * Google trata como conteúdo raso.
 */
function buildWindow(current: number, total: number): Array<number | 'gap'> {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const pages = new Set([1, total, current - 1, current, current + 1]);
  const sorted = [...pages].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);

  const result: Array<number | 'gap'> = [];
  let previous = 0;

  for (const value of sorted) {
    if (previous && value - previous > 1) result.push('gap');
    result.push(value);
    previous = value;
  }

  return result;
}

const items = buildWindow(page, totalPages);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label={label}>
      {page > 1 ? (
        <a class="pagination__edge" href={buildHref(page - 1)} rel="prev">
          <span aria-hidden="true">←</span> Anterior
        </a>
      ) : (
        <span class="pagination__edge pagination__edge--off" aria-hidden="true">
          ← Anterior
        </span>
      )}

      <ol class="pagination__pages">
        {items.map((item) =>
          item === 'gap' ? (
            <li class="pagination__gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              <a
                href={buildHref(item)}
                class="pagination__page"
                aria-current={item === page ? 'page' : undefined}
                aria-label={`Página ${item}`}
              >
                {item}
              </a>
            </li>
          ),
        )}
      </ol>

      {page < totalPages ? (
        <a class="pagination__edge" href={buildHref(page + 1)} rel="next">
          Próxima <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="pagination__edge pagination__edge--off" aria-hidden="true">
          Próxima →
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line);
    font-size: 0.875rem;
  }

  .pagination__edge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    color: var(--c-ink);
  }

  .pagination__edge:hover {
    color: var(--c-ember);
  }

  .pagination__edge--off {
    color: var(--c-line-strong);
  }

  .pagination__pages {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pagination__page,
  .pagination__gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem;
    border-radius: 100px;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink-muted);
    transition:
      background-color 0.2s var(--ease-out-soft),
      color 0.2s var(--ease-out-soft);
  }

  .pagination__page:hover {
    background-color: var(--c-surface-2);
    color: var(--c-ink);
  }

  .pagination__page[aria-current='page'] {
    background-color: var(--c-ink);
    color: var(--c-paper);
    font-weight: 600;
  }

  .pagination__gap {
    color: var(--c-line-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination__page {
      transition: none;
    }
  }
</style>
