{
  "name": "contracorrente",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Blog editorial estático em pt-BR, monetizado com Google AdSense, publicado em hospedagem Apache compartilhada.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/sync-cms.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "stop": "node scripts/stop.mjs",
    "prebuild": "node scripts/sync-cms.mjs",
    "build": "astro check && astro build --force",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run test && npm run build:fast",
    "astro": "astro",
    "prebuild:fast": "node scripts/sync-cms.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "gsap": "^3.15.0",
    "satteri": "^0.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sveltia/cms": "^0.176.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
