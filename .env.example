# ============================================================================
#  Variáveis de ambiente — copie para `.env` e preencha.
#
#  Tudo aqui tem o prefixo PUBLIC_, ou seja: vai embutido no HTML/JS final e é
#  visível para qualquer visitante. Isso é correto para estes valores — um
#  client ID de AdSense e um endpoint de formulário são públicos por natureza.
#
#  NUNCA coloque um segredo de verdade num PUBLIC_. O site é estático: não
#  existe servidor onde um segredo pudesse ficar escondido.
#
#  Depois de alterar qualquer valor daqui, rode `npm run build` (que já usa
#  --force). Os blocos de anúncio dentro do artigo são gravados no HTML em
#  tempo de build e ficam em cache — um `astro build` sem --force reaproveita
#  o HTML antigo e os anúncios não aparecem.
# ============================================================================

# ---------------------------------------------------------------------------
#  Google AdSense
#  Painel: https://www.google.com/adsense → Anúncios → Por unidade de anúncio
# ---------------------------------------------------------------------------

# Client ID, no formato ca-pub-0000000000000000 (com o prefixo "ca-").
# Deixe vazio antes da aprovação: sem ele, nenhum bloco de anúncio é
# renderizado e o site fica limpo para a revisão manual do Google.
PUBLIC_ADSENSE_CLIENT=

# IDs numéricos de cada unidade de anúncio (10 dígitos).
# Crie uma unidade "Display responsivo" para cada posição.
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_MID_CONTENT=
PUBLIC_ADSENSE_SLOT_FOOTER=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ---------------------------------------------------------------------------
#  Formulário de contato
#  Crie um form em https://formspree.io e cole a URL completa do endpoint.
#  Sem este valor, a página /contato exibe o e-mail direto como alternativa.
# ---------------------------------------------------------------------------

PUBLIC_FORMSPREE_ENDPOINT=
